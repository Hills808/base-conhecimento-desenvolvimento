{
  "name": "curva-aberta-notes",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-26",
  "workers_dev": true,
  "observability": {
    "enabled": false
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://hills808.github.io",
    "WRITES_ENABLED": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "curva-aberta-notes",
      "database_id": "7f022186-4c83-4512-846b-f10120047eb5",
      "migrations_dir": "migrations"
    },
    {
      "binding": "ATTACHMENTS_DB",
      "database_name": "curva-aberta-anexos",
      "database_id": "d2210a76-0d1f-4721-8ae2-ae059c93f105"
    }
  ],
  "previews": {
    "vars": {
      "ALLOWED_ORIGIN": "https://hills808.github.io",
      "WRITES_ENABLED": "false"
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "curva-aberta-notes",
        "database_id": "7f022186-4c83-4512-846b-f10120047eb5",
        "migrations_dir": "migrations"
      },
      {
        "binding": "ATTACHMENTS_DB",
        "database_name": "curva-aberta-anexos-teste",
        "database_id": "e5973cd0-6b74-4d48-ae8d-614b746843ef"
      }
    ]
  }
}
